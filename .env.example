DATABASE_URL="postgresql://lexi:lexi_secret@localhost:5432/lexipdf"
NEXTAUTH_SECRET="your-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
STORAGE_PROVIDER="local"

# LLM provider for chat + summarization: "groq" (default), "openai", or "gemini"
LLM_PROVIDER="groq"

# Embedding provider: "huggingface" (default, 384 dims), "gemini" (768 dims), or "openai" (1536 dims)
# WARNING: Changing this requires a schema migration + full re-ingestion of all PDFs.
# Current schema is vector(384) — matches EMBEDDING_PROVIDER=huggingface.
EMBEDDING_PROVIDER="huggingface"

# Required when LLM_PROVIDER=groq. Chat/summarization only — Groq has no embeddings API.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# Required when EMBEDDING_PROVIDER=huggingface (hosted Inference API, not local transformers.js).
# Get a free token at https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_KEY="hf_..."

# Fallback/alternative providers (not used by default):

# Required when LLM_PROVIDER=gemini or EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY="AIza..."

# Required when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai
OPENAI_API_KEY="sk-..."
