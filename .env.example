DATABASE_URL="postgresql://lexi:lexi_secret@localhost:5432/lexipdf"
NEXTAUTH_SECRET="your-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
STORAGE_PROVIDER="local"

# LLM provider for chat: "openai" (default) or "gemini"
LLM_PROVIDER="gemini"

# Embedding provider: "gemini" (default, 768 dims) or "openai" (1536 dims)
# WARNING: Changing this requires a schema migration + full re-ingestion of all PDFs.
# Current schema is vector(768) — matches EMBEDDING_PROVIDER=gemini.
EMBEDDING_PROVIDER="gemini"

# Required when LLM_PROVIDER=gemini or EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY="AIza..."

# Required when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai
OPENAI_API_KEY="sk-..."
